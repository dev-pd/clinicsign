# Copy to `.env.local` in this directory (`cp .env.example .env.local`) and fill in real values.
# `.env.local` is gitignored. Do not commit secrets.

# ------------------------------------------------------------------------------
# Clerk (https://dashboard.clerk.com — same "Application" as the API)
# ------------------------------------------------------------------------------
# Used by the browser (safe to be public).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Used by Clerk on the server (Next.js route handlers, Server Actions, auth()).
# Must match the Secret key for the same Clerk application as above.
CLERK_SECRET_KEY=sk_test_replace_me

# ------------------------------------------------------------------------------
# Backend API (Express — `npm run dev` in this monorepo usually runs API on 4000)
# ------------------------------------------------------------------------------
# Server Components (e.g. dashboard → GET /api/me) call this URL.
API_URL=http://localhost:4000

# If you only run the API via Docker (`npm run docker:api`), use:
# API_URL=http://localhost:4001

# Optional: browser-side calls later (must be NEXT_PUBLIC_*).
# NEXT_PUBLIC_API_URL=http://localhost:4000
