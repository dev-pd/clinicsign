# Copy to `.env` at the repo root and/or `apps/api/.env` (API loads both).
# Values below are dev placeholders so `npm run dev` can start the API — replace for real keys.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database (Docker Compose maps Postgres to host port 5433)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/clinicsign

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Next.js (web app; public)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# AWS / LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
# Optional — omit entirely if not using LocalStack
AWS_ENDPOINT_URL=http://127.0.0.1:4566
S3_BUCKET_NAME=clinicsign-dev

# Email (Resend)
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=re_replace_me

# URLs
WEB_APP_URL=http://localhost:3000
# Local API from `npm run dev` (apps/api) listens on 4000 — use this for normal development:
API_URL=http://localhost:4000
# If you run the Dockerized API (`npm run docker:api`), it is exposed on host 4001 instead:
# API_URL=http://localhost:4001

# Patient signing tokens (min 32 characters)
JWT_SIGNING_SECRET=local_dev_jwt_signing_secret_32chars_min_______
