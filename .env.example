# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clinicsign

# Clerk (dashboard: https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Next.js (public; must match CLERK_PUBLISHABLE_KEY)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# AWS / LocalStack (local dev often uses dummy keys + LocalStack endpoint)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=clinicsign-dev

# Email
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=

# URLs
WEB_APP_URL=http://localhost:3000
# Local API from `npm run dev` (apps/api) listens on 4000 — use this for normal development:
API_URL=http://localhost:4000
# If you run the Dockerized API (`npm run docker:api`), it is exposed on host 4001 instead:
# API_URL=http://localhost:4001

# API server (Express in dev / container both use 4000 inside the process; Docker maps host 4001->4000)
PORT=4000
