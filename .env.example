# Copy to `.env` at the repo root and/or `apps/api/.env` (API loads both).
# Values below are dev placeholders so `npm run dev` can start the API — replace for real keys.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database — use AWS RDS (PostgreSQL). After `pulumi up` in `infra/`:
#   pulumi stack output databaseUrl --show-secrets
# Paste the connection string here (TLS required; string includes sslmode=require).
DATABASE_URL=postgresql://clinicsign:PASSWORD@YOUR_RDS_HOSTNAME:5432/clinicsign?sslmode=require

# Clerk — https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Next.js (web app; public) — also duplicate Clerk + API_URL into `apps/web/.env.local`
# (see `apps/web/.env.example`).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# AWS — real account. From `pulumi up` in `infra/`:
#   - s3BucketName → S3_BUCKET_NAME
#   - iamAccessKeyId / iamSecretAccessKey → below (store securely; prefer IAM roles on ECS in prod)
#   - kmsKeyArn if you need it for debugging
# Do NOT set AWS_ENDPOINT_URL (omit it so the SDK uses real AWS endpoints).
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=clinicsign-dev-docs-xxxx

# Email (Resend)
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=re_replace_me

# URLs
WEB_APP_URL=http://localhost:3000
# Local API from `npm run dev` (apps/api) listens on 4000 — use this for normal development:
API_URL=http://localhost:4000
# Next.js server components read env from `apps/web` — copy `API_URL` (and Clerk keys) into `apps/web/.env.local` if dashboard → API fetch fails
# If you run the Dockerized API (`npm run docker:api`), it is exposed on host 4001 instead:
# API_URL=http://localhost:4001

# Patient signing tokens (min 32 characters)
JWT_SIGNING_SECRET=local_dev_jwt_signing_secret_32chars_min_______
